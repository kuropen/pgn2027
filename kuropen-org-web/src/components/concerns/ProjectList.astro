---
import RightArrow from '../../assets/icons/right.svg';
---

<section class="my-8 p-4 border border-gray-500 rounded-xl flex flex-col gap-4">
    <h1 class="text-2xl">プロジェクト一覧</h1>
    <nav>
        <ul class="flex flex-col gap-2">
             <li>
                <a href="/micropen" class="p-2 border border-gray-500 rounded-xl flex gap-2 items-center hover:bg-blue-600 hover:text-gray-100">
                    <p class="grow">MICROPEN</p>
                    <RightArrow role="presentation" />
                </a>
             </li>
             <li>
                <a href="/works" class="p-2 border border-gray-500 rounded-xl flex gap-2 items-center hover:bg-blue-600 hover:text-gray-100">
                    <p class="grow">小規模プロジェクトの紹介</p>
                    <RightArrow role="presentation" />
                </a>
             </li>
        </ul>
    </nav>
</section>

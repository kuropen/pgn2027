---
import type { BreadcrumbsElement } from '../types';
import '../styles/global.css';
import { Font } from "astro:assets";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

type Props = {
	title?: string;
	breadcrumbs?: BreadcrumbsElement[];
	isHome?: boolean;
}

const pageTitle = Astro.props.title;
const shownTitle = (pageTitle ? `${pageTitle} - ` : '') + 'Penguinone';

const breadcrumbs: BreadcrumbsElement[] = [
	{
		title: 'ホーム',
		url: '/',
	}
]
if (!Astro.props.isHome) {
	Astro.props.breadcrumbs?.filter((element) => element.title !== 'トップページ').forEach((element) => breadcrumbs.push(element))
	breadcrumbs.push({title: pageTitle || '現在のページ'})
}
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{shownTitle}</title>
		<Font cssVariable='--font-ibm-plex-sans-jp' />
		<style>
			body {
				font-family: --font-ibm-plex-sans-jp, sans-serif;
			}
		</style>
	</head>
	<body>
		<div id="headAccent" role="presentation"></div>
		<div class="my-2 mx-auto max-w-3xl px-4">
			<Header />
			{Astro.props.isHome ? null : <Breadcrumbs breadcrumbs={breadcrumbs} />}
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

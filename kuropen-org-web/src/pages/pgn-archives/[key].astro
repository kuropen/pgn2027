---
import { getCollection } from "astro:content";

export const prerender = false;

const redirctedArchiveCollection = await getCollection('redirctedArchives');

const { key } = Astro.params;

const referencedArchive = redirctedArchiveCollection.find((archive) => archive.data.old_path === key)
return Astro.redirect(referencedArchive?.data.new_url || '/404', 303);
---

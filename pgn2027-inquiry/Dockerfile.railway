FROM dunglas/frankenphp:1-php8.4

RUN install-php-extensions pcntl pdo_pgsql pdo_sqlite redis mbstring intl zip
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
COPY . .
RUN composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader \
    && php artisan octane:install --server=frankenphp --no-interaction \
    && chown -R www-data:www-data storage bootstrap/cache /data /config
USER www-data
HEALTHCHECK NONE
EXPOSE 8000
ENTRYPOINT []
CMD ["php", "artisan", "octane:start", "--server=frankenphp", "--host=0.0.0.0", "--port=8000", "--workers=2", "--max-requests=500"]
